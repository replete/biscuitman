{
	"name": "biscuitman",
	"version": "0.6.0",
	"description": "Super lightweight open-source privacy consent manager for your website ",
	"browser": "biscuitman.js",
	"keywords": [
		"privacy",
		"cookie",
		"cookies",
		"trackers",
		"cookie-consent",
		"gdpr",
		"consents",
		"consent-manager"
	],
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "node ./run.js build serve",
		"build": "node ./run.js build",
		"report": "node ./run.js report",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:report": "playwright show-report",
		"lint": "eslint",
		"makecerts": "mkcert -cert-file server.crt -key-file server.key localhost 127.0.0.1 ::1",
		"http": "npx http-server -p 8000 -a 0.0.0.0"
	},
	"test": "npm run test",
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@babel/core": "^8.0.7",
		"@babel/plugin-transform-for-of": "^8.0.7",
		"@babel/preset-env": "^8.0.7",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@swc/core": "^1.16.18",
		"browser-sync": "^3.0.4",
		"browserslist": "^4.29.3",
		"dialog-polyfill": "^0.5.6",
		"doiuse": "^6.0.6",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"lightningcss": "^1.33.0",
		"rollup": "^4.64.6"
	},
	"browserslist": "since 2023, not dead",
	"author": "replete",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/replete/biscuitman.git"
	},
	"bugs": {
		"url": "https://github.com/replete/biscuitman/issues"
	},
	"funding": "https://buymeacoffee.com/replete",
	"homepage": "https://replete.github.io/biscuitman",
	"allowScripts": {
		"fsevents@2.3.3": true,
		"fsevents@2.3.2": true,
		"@swc/core@1.16.18": true
	}
}
